// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String
  password String
  slug     String? @unique
  avatar   String?

  // Dados do freelancer
  phone String?
  cpf   String? @unique
  cnpj  String? @unique

  // Configurações
  company String? // Nome da empresa/MEI
  bio     String? @db.Text

  // Recuperação de senha
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // Two-Factor Authentication (2FA)
  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[] @default([])

  // Plano e assinatura
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeAccountId      String?   @unique  // Stripe Connect Express
  stripeAccountStatus  String?             // 'pending' | 'active' | 'restricted'
  stripeSubscriptionId String?
  subscriptionStatus   String?             // 'active' | 'canceled' | 'past_due' | 'trialing'
  currentPeriodEnd     DateTime?

  // Dados fiscais (NFS-e)
  enotasEmpresaId    String?          // ID da empresa na eNotas
  cnae               String?          // Código CNAE principal
  issAliquota        Decimal? @db.Decimal(5, 2) // Alíquota ISS (%)
  inscricaoMunicipal String?
  regimeTributario   Int?             // 1-SimplesNacional, 2-LucroPresumido, etc.
  codigoServico      String?          // Código do serviço municipal

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  clientes     Cliente[]
  orcamentos   Orcamento[]
  projetos     Projeto[]
  pagamentos   Pagamento[]
  templates    Template[]
  notificacoes Notificacao[]
  notasFiscais NotaFiscal[]
  timeEntries  TimeEntry[]
  despesas     Despesa[]
  comentarios  Comentario[]

  @@map("users")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

// ============================================
// CLIENTES
// ============================================

model Cliente {
  id String @id @default(cuid())

  // Dados básicos
  name   String
  email  String
  phone  String?
  avatar String?

  // Dados da empresa (se for PJ)
  company String?
  cnpj    String?

  // Endereço
  address String?
  city    String?
  state   String?
  zipCode String?

  // Observações
  notes String? @db.Text

  // Status
  active Boolean @default(true)

  // Portal do cliente (magic link auth)
  portalToken        String?
  portalTokenExpires DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orcamentos  Orcamento[]
  projetos    Projeto[]
  solicitacao Solicitacao[]

  @@index([userId])
  @@map("clientes")
}

// ============================================
// ORÇAMENTOS
// ============================================

model Orcamento {
  id String @id @default(cuid())

  number      String
  title       String
  description String @db.Text

  value Decimal @db.Decimal(10, 2)

  estimatedDays Int?
  validUntil    DateTime?

  status OrcamentoStatus @default(AGUARDANDO)

  notes String? @db.Text

  attachments Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sentAt     DateTime?
  approvedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  orcamentoId String? @unique

  projeto Projeto?

  solicitacaoId String?      @unique
  solicitacao   Solicitacao? @relation(fields: [solicitacaoId], references: [id])

  @@index([userId])
  @@index([clienteId])
  @@index([status])
  @@map("orcamentos")
}

enum OrcamentoStatus {
  AGUARDANDO // Aguardando elaboração do orçamento
  ENVIADO // Orçamento enviado ao cliente
  APROVADO // Cliente aprovou
  RECUSADO // Cliente recusou
  EXPIRADO // Passou da validade
}

// ============================================
// PROJETOS
// ============================================

model Projeto {
  id String @id @default(cuid())

  // Identificação
  number      String // PRJ-001, PRJ-002...
  title       String
  description String @db.Text

  // Valores
  value Decimal @db.Decimal(10, 2)

  // Prazos
  startDate DateTime  @default(now())
  endDate   DateTime?

  // Status
  status   ProjetoStatus @default(EM_ANDAMENTO)
  progress Int           @default(0) // 0-100%

  // Observações
  notes String? @db.Text

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relações
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  orcamentoId String?    @unique
  orcamento   Orcamento? @relation(fields: [orcamentoId], references: [id])

  milestones  Milestone[]
  pagamentos  Pagamento[]
  arquivos    Arquivo[]
  timeEntries TimeEntry[]
  despesas    Despesa[]
  comentarios Comentario[]

  @@index([userId])
  @@index([clienteId])
  @@index([status])
  @@map("projetos")
}

enum ProjetoStatus {
  EM_ANDAMENTO
  PAUSADO
  CONCLUIDO
  CANCELADO
}

// ============================================
// MILESTONES (Etapas do Projeto)
// ============================================

model Milestone {
  id String @id @default(cuid())

  title       String
  description String? @db.Text

  // Ordem
  order Int

  // Status
  completed   Boolean   @default(false)
  completedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("milestones")
}

// ============================================
// PAGAMENTOS
// ============================================

model Pagamento {
  id String @id @default(cuid())

  // Identificação
  description String

  // Valores
  value Decimal @db.Decimal(10, 2)

  // Datas
  dueDate DateTime // Data prevista
  paidAt  DateTime? // Data que foi pago

  // Status
  status PagamentoStatus @default(PENDENTE)

  // Método de pagamento
  method String? // Pix, Transferência, Boleto, etc

  // Observações
  notes String? @db.Text

  // Comprovante
  receipt String? // URL do comprovante

  // Stripe
  stripePaymentIntentId   String? @unique
  stripeCheckoutSessionId String?
  paymentUrl              String? // Checkout URL para cliente pagar

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  notaFiscal NotaFiscal?

  @@index([userId])
  @@index([projetoId])
  @@index([status])
  @@map("pagamentos")
}

enum PagamentoStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

// ============================================
// NOTAS FISCAIS (NFS-e)
// ============================================

model NotaFiscal {
  id String @id @default(cuid())

  // eNotas
  enotasNfeId       String? @unique
  numero            String?
  codigoVerificacao String?

  // Dados da nota
  status           NotaFiscalStatus @default(PENDENTE)
  descricaoServico String           @db.Text
  valor            Decimal          @db.Decimal(10, 2)
  issAliquota      Decimal          @db.Decimal(5, 2)
  issValor         Decimal          @db.Decimal(10, 2)

  // Arquivos
  pdfUrl String?
  xmlUrl String?

  // Rejeição / Cancelamento
  motivoRejeicao     String?
  motivoCancelamento String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  emitidaEm   DateTime?
  canceladaEm DateTime?

  // Relações
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pagamentoId String    @unique
  pagamento   Pagamento @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("notas_fiscais")
}

enum NotaFiscalStatus {
  PENDENTE    // Criada localmente
  PROCESSANDO // Enviada para eNotas
  AUTORIZADA  // Autorizada pela prefeitura
  REJEITADA   // Rejeitada pela prefeitura
  CANCELADA
}

// ============================================
// ARQUIVOS
// ============================================

model Arquivo {
  id String @id @default(cuid())

  name String
  url  String
  size Int // Tamanho em bytes
  type String // MIME type

  // Timestamps
  createdAt DateTime @default(now())

  // Relações
  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("arquivos")
}

// ============================================
// TEMPLATES (Propostas, Contratos, etc)
// ============================================

model Template {
  id String @id @default(cuid())

  name    String
  type    TemplateType
  content String       @db.Text // HTML ou Markdown
  value   Decimal?     @db.Decimal(10, 2) // Valor padrão para pré-preenchimento

  // Status
  active Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("templates")
}

// ============================================
// COMENTÁRIOS EM PROJETOS (Threaded)
// ============================================

model Comentario {
  id      String @id @default(cuid())
  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comentario?  @relation("ComentarioReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comentario[] @relation("ComentarioReplies")

  @@index([projetoId])
  @@index([parentId])
  @@map("comentarios")
}

enum TemplateType {
  PROPOSTA
  CONTRATO
  RECIBO
}

// ============================================
// SOLICITAÇÕES (Briefings de Clientes)
// ============================================

model Solicitacao {
  id String @id @default(cuid())

  // Dados da solicitação
  title       String
  description String    @db.Text
  budget      Decimal?  @db.Decimal(10, 2) // Orçamento estimado do cliente
  deadline    DateTime? // Prazo esperado pelo cliente

  // Arquivos/anexos que o cliente enviou
  attachments Json? // Array de URLs

  // Status
  status solicitacaoStatus @default(NOVA)

  // Observações internas (só você vê)
  notes String? @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Quando você criar o orçamento baseado nessa solicitação
  orcamento Orcamento?

  @@index([clienteId])
  @@index([status])
  @@map("solicitacoes")
}

enum solicitacaoStatus {
  NOVA // Cliente acabou de enviar
  ANALISANDO // Você está analisando
  ORCAMENTO_ENVIADO // Você já criou e enviou o orçamento
  ARQUIVADA // Solicitação arquivada
}

// ============================================
// NOTIFICAÇÕES IN-APP
// ============================================

model Notificacao {
  id      String          @id @default(cuid())
  type    NotificacaoType
  title   String
  message String
  link    String?
  read    Boolean         @default(false)
  readAt  DateTime?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notificacoes")
}

enum NotificacaoType {
  ORCAMENTO_APROVADO
  ORCAMENTO_RECUSADO
  PROJETO_CRIADO
  PAGAMENTO_CONFIRMADO
  PAGAMENTO_LEMBRETE
  PAGAMENTO_VENCIDO
  MILESTONE_CONCLUIDO
  ARQUIVO_DISPONIVEL
  SOLICITACAO_RECEBIDA
  NFSE_AUTORIZADA
  NFSE_REJEITADA
}

// ============================================
// TIME TRACKING
// ============================================

model TimeEntry {
  id          String    @id @default(cuid())
  description String
  startTime   DateTime
  endTime     DateTime?
  duration    Int?      // Duração em minutos (calculado ou manual)
  billable    Boolean   @default(true)
  hourlyRate  Decimal?  @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projetoId])
  @@map("time_entries")
}

// ============================================
// DESPESAS
// ============================================

model Despesa {
  id          String          @id @default(cuid())
  description String
  value       Decimal         @db.Decimal(10, 2)
  date        DateTime
  category    DespesaCategory
  receipt     String?
  notes       String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projetoId String?
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projetoId])
  @@index([category])
  @@map("despesas")
}

enum DespesaCategory {
  SOFTWARE
  HARDWARE
  TRANSPORTE
  ALIMENTACAO
  MARKETING
  EDUCACAO
  ESCRITORIO
  IMPOSTOS
  OUTROS
}
